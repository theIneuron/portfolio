# Server-only Telegram credentials. Never prefix these with NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: comma-separated exact origins for custom domains.
# CONTACT_ALLOWED_ORIGINS=https://example.uz,https://www.example.uz
CONTACT_ALLOWED_ORIGINS=

# Optional stable salt for the best-effort per-instance rate limiter.
CONTACT_HASH_SALT=
